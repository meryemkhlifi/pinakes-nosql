{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.app.main:app", "--reload", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "UI (streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "frontend/Home.py"],
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}
